{
  "name": "app",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "build": "bunx tsc --noEmit && bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "migrate:notification-preferences": "bun run scripts/run-notification-preferences-migration.ts",
    "migrate:quota": "bun run scripts/run-quota-migration.ts",
