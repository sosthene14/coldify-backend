    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/web-push": "^3.6.4",
    "axios": "^1.20.0",
    "better-auth": "^1.6.25",
    "bullmq": "^5.81.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "google-auth-library": "^11.0.0",
    "googleapis": "^173.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "resend": "^6.18.0",
    "sanitize-html": "^2.17.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/jsonwebtoken": "^9.0.10",
